<dl class="dl-horizontal dl-invert">
  <% define_react_components(fields, items, uri).each do |label, type, args| %>
    <dt><%= label %>:</dt>
    <dd>
      <% if substitute_htmx(args) %>
        <%= render htmx_partial(args[:componentType]), type: type, args: args %>
      <% else %>
        <%= react_component(type, **args) %>
      <% end %>
    </dd>
  <% end %>
</dl>
