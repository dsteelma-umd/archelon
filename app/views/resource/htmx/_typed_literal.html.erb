<% original_value = ""
value_type = ""
if args[:value] != nil
  original_value =  args[:value][:@value] || ''
  value_type = args[:value][:@type] || ''
end
%>
<div>
</div>
<input title="<%= value_type %>" size="40" value="<%= original_value %>"
    hx-post="/htmx/replace" hx-target="previous" hx-trigger="keyup"
    hx-vals='js:{new_value: event.target.value, "value_type": "<%= value_type %>", "subject": "<%= args[:subjectURI] %>", "predicate": "<%= args[:predicateURI] %>", "original_value": "<%= original_value %>"}'/>
